# Copy this file to .env.production and replace every CHANGE_ME value.
# Start with:
# docker compose --env-file .env.production --profile production up -d --build

LFS_IMAGE=license-facade-service:0.1.8
BUILD_DATE=2026-08-13
LFS_HOST_PORT=12104

# PostgreSQL created by the production Compose profile.
# URL-encode reserved characters if you put the password in LFS_DATABASE_URL.
LFS_POSTGRES_DB=lfs
LFS_POSTGRES_USER=lfs
LFS_POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
LFS_DATABASE_URL=postgresql+psycopg://lfs:CHANGE_ME_DATABASE_PASSWORD@lfs-postgres:5432/lfs
# The bundled PostgreSQL service installs docker/postgres-init/001-lfs-schema.sql only on first start
# against an empty data volume.

# Public identity of this LFS node. Generate a unique UUID per deployment.
APP_NAME=License Facade Service
URL_BASE=https://lfs.example.org/api/v1/licenses
FEDERATION_NODE_ID=CHANGE_ME_UUID
FEDERATION_PUBLIC_BASE_URL=https://lfs.example.org
FEDERATION_NODE_NAME=CHANGE_ME_NODE_NAME
FEDERATION_OPERATOR=CHANGE_ME_OPERATOR
FEDERATION_ACTIVE_KID=lfs-production-k1
FEDERATION_ENABLED=true
FEDERATION_INBOUND_ENABLED=true
FEDERATION_JWKS_ENABLED=true

# API authentication. Use long random values and keep this file private.
LFS_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
LFS_CURATOR_TOKEN=CHANGE_ME_LONG_RANDOM_CURATOR_TOKEN

# Custom-licence authority identity.
CUSTOM_LICENCE_AUTHORITY_ID=CHANGE_ME_AUTHORITY_ID
CUSTOM_LICENCE_AUTHORITY_BASE_IRI=https://lfs.example.org
CUSTOM_LICENCE_CREATOR_ORGANIZATION_NAME=CHANGE_ME_ORGANIZATION
CUSTOM_LICENCE_CREATOR_ORGANIZATION_IRI=https://lfs.example.org/spdx/agents/lfs-operator

# Fuseki. The production profile creates the service and persistent volume.
FUSEKI_ENABLE=true
FUSEKI_ADMIN_PASSWORD=CHANGE_ME_FUSEKI_PASSWORD
FUSEKI_USER=admin

# Trusted-peer synchronization permits HTTPS/443 by default.
FEDERATION_SYNC_ALLOWED_PORTS=443
FEDERATION_SYNC_ALLOWED_HOSTNAMES=
FEDERATION_SYNC_ALLOWED_CIDRS=
FEDERATION_ALLOW_PRIVATE_NETWORK=false

# Optional OpenREL provider.
OPENREL_ENABLED=false
OPENREL_BASE_URL=

# Optional browser origins, comma-separated according to LFS configuration.
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
