# License Facade Service Environment Variables

# Application Configuration
APP_NAME=License Facade Service
EXPOSE_PORT=12104
BASE_DIR=/home/akmi/lfs
URL_BASE=https://lfs.labs.dansdemo.nl/api/v1/licenses

# Docker Build
BUILD_DATE=2026-03-02

# Apache Jena Fuseki Configuration
FUSEKI_URL=http://fuseki:3030
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin
FUSEKI_ENABLE=true
FUSEKI_CLEAR_ON_STARTUP=false
FUSEKI_ADMIN_PASSWORD=admin
FUSEKI_JVM_ARGS=-Xmx2g -Xms1g

# Note: For local development, use:
# FUSEKI_URL=http://localhost:3030
# For Docker Compose, use:
# FUSEKI_URL=http://fuseki:3030 (service name)

# OpenREL read-only facade (disabled by default)
# OPENREL_BASE_URL is the provider API root path (not just origin), e.g.
# https://provider.example/openrel/api/v0.4
OPENREL_ENABLED=false
OPENREL_BASE_URL=
OPENREL_ALLOW_HTTP_FOR_DEMO=false
OPENREL_CONNECT_TIMEOUT_SECONDS=5
OPENREL_READ_TIMEOUT_SECONDS=15
OPENREL_WRITE_TIMEOUT_SECONDS=10
OPENREL_POOL_TIMEOUT_SECONDS=5
OPENREL_TOTAL_TIMEOUT_SECONDS=20
OPENREL_RETRY_ATTEMPTS=3
OPENREL_RETRY_BASE_SECONDS=0.2
OPENREL_RETRY_MAX_SECONDS=2
OPENREL_MAX_LIST_RESPONSE_BYTES=2000000
OPENREL_MAX_DETAIL_RESPONSE_BYTES=512000
OPENREL_MAX_ID_LENGTH=2048
OPENREL_MAX_PREFIX_LENGTH=128
OPENREL_ALLOWED_PORTS=443
OPENREL_ALLOWED_HOSTNAMES=
OPENREL_ALLOWED_CIDRS=

# Custom licence registration (Phase 2)
# - Independent of federation runtime: FEDERATION_ENABLED is not required.
# - Requires PostgreSQL and an upgraded schema before use:
#   ALEMBIC_DATABASE_URL=<same database url> uv run alembic -c alembic.ini upgrade head
# - If CUSTOM_LICENCE_REGISTRATION_DATABASE_URL is empty, registration endpoint returns 503.
# - `spdx-submission` marks readiness only; it does not contact SPDX/GitHub and does not create PRs.
# - Federated registration remains deferred to Phase 3.
CUSTOM_LICENCE_REGISTRATION_DATABASE_URL=
CUSTOM_LICENCE_AUTHORITY_ID=lfs-local-authority
CUSTOM_LICENCE_AUTHORITY_BASE_IRI=https://lfs.example
CUSTOM_LICENCE_CREATOR_ORGANIZATION_NAME=LFS Operator
CUSTOM_LICENCE_CREATOR_ORGANIZATION_IRI=https://lfs.example/spdx/agents/lfs-operator

# Notes:
# - HTTP is demo-only; production should use HTTPS.
# - If using HTTP on port 80, add 80 to OPENREL_ALLOWED_PORTS explicitly.
# - For private/Docker-network providers, configure all of:
#   OPENREL_ALLOW_HTTP_FOR_DEMO=true (if HTTP is used),
#   OPENREL_ALLOWED_HOSTNAMES=<exact-hostname>,
#   OPENREL_ALLOWED_CIDRS=<private-cidr>,
#   OPENREL_ALLOWED_PORTS=<provider-port>.
# - Metadata destinations remain blocked even when private CIDRs are configured.
# - Apply production egress restrictions in addition to application checks.
