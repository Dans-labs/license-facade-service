# License Facade Service Environment Variables

# Application Configuration
APP_NAME=License Facade Service
EXPOSE_PORT=12104
BASE_DIR=/home/akmi/lfs
URL_BASE=https://lfs.labs.dansdemo.nl/api/v1/licenses

# Docker Build
BUILD_DATE=2026-03-02

# Apache Jena Fuseki Configuration
FUSEKI_URL=http://fuseki:3030
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin
FUSEKI_ENABLE=true
FUSEKI_CLEAR_ON_STARTUP=false
FUSEKI_ADMIN_PASSWORD=admin
FUSEKI_JVM_ARGS=-Xmx2g -Xms1g

# Note: For local development, use:
# FUSEKI_URL=http://localhost:3030
# For Docker Compose, use:
# FUSEKI_URL=http://fuseki:3030 (service name)

