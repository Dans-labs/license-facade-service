lfs:d1b405f5-98e2-5acd-9f7b-531983fb5aad a spdx:License ;
    rdfs:label "BSD Zero Clause License" ;
    dcterms:identifier "0BSD" ;
    dcterms:title "BSD Zero Clause License" ;
    spdx:crossRef [ a spdx:CrossRef ;
            dcterms:date "2026-02-20T20:59:24+00:00"^^xsd:dateTime ;
            spdx:isLive false ;
            spdx:isValid true ;
            spdx:isWayBackLink false ;
            spdx:match "N/A" ;
            spdx:order 0 ;
            spdx:url <http://landley.net/toybox/license.html> ],
        [ a spdx:CrossRef ;
            dcterms:date "2026-02-20T20:59:24+00:00"^^xsd:dateTime ;
            spdx:isLive true ;
            spdx:isValid true ;
            spdx:isWayBackLink false ;
            spdx:match "N/A" ;
            spdx:order 1 ;
            spdx:url <https://opensource.org/licenses/0BSD> ] ;
    spdx:isDeprecatedLicenseId false ;
    spdx:isOsiApproved true ;
